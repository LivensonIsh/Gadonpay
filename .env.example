# Serveur
PORT=3000
NODE_ENV=development

# Base de données (PostgreSQL)
DATABASE_URL="postgresql://gadonpay:gadonpay@localhost:5432/gadonpay?schema=public"

# Auth marchand (dashboard)
JWT_SECRET="change-me-in-production-use-a-long-random-value"
JWT_EXPIRES_IN="7d"

# Auth admin interne (dashboard admin, section 7.2 de la spec)
ADMIN_JWT_SECRET="change-me-too-different-secret-than-JWT_SECRET"
ADMIN_JWT_EXPIRES_IN="12h"

# Fenêtre de matching (minutes) : au-delà, un Payment PENDING passe en EXPIRED
PAYMENT_EXPIRY_MINUTES=30

# Tolérance de matching temporel entre une Transaction SMS et un Payment (minutes)
MATCHING_TIME_WINDOW_MINUTES=20

# Chiffrement au repos (SMS bruts + webhook secrets) — AES-256-GCM
# ⚠️ En production : à sortir d'un vrai coffre-fort de secrets (KMS/Vault), jamais en clair ici.
MASTER_ENCRYPTION_KEY="change-me-to-a-long-random-value-in-production"

# Webhooks
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=8000
